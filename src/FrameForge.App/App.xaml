<Application x:Class="FrameForge.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ShutdownMode="OnMainWindowClose">
<Application.Resources>
<SolidColorBrush x:Key="Surface" Color="#141E30"/><SolidColorBrush x:Key="Accent" Color="#5EE0BA"/>
<Style TargetType="Window"><Setter Property="Background" Value="#0B1220"/><Setter Property="Foreground" Value="#E9EFF8"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="14"/></Style>
<Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E9EFF8"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
<Style TargetType="Button"><Setter Property="Foreground" Value="#E9EFF8"/><Setter Property="Background" Value="#23334C"/><Setter Property="Padding" Value="15,9"/><Setter Property="Margin" Value="0,4,8,4"/><Setter Property="Cursor" Value="Hand"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Body" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Body" Property="Background" Value="#344A66"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Body" Property="BorderBrush" Value="#5EE0BA"/><Setter TargetName="Body" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Body" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="TextBox"><Setter Property="Background" Value="#19263A"/><Setter Property="Foreground" Value="#E9EFF8"/><Setter Property="CaretBrush" Value="White"/><Setter Property="BorderBrush" Value="#34445C"/><Setter Property="Padding" Value="10"/><Setter Property="Margin" Value="0,5,8,8"/></Style>
<Style TargetType="ComboBox"><Setter Property="Foreground" Value="#122036"/><Setter Property="MinWidth" Value="150"/><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="0,5,8,8"/></Style>
<Style TargetType="CheckBox"><Setter Property="Foreground" Value="#E9EFF8"/><Setter Property="Margin" Value="0,8,0,8"/></Style>
<Style TargetType="ListBox"><Setter Property="Background" Value="#141E30"/><Setter Property="Foreground" Value="#E9EFF8"/><Setter Property="BorderThickness" Value="0"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/><Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/><Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/></Style>
<Style TargetType="ListBoxItem"><Setter Property="Foreground" Value="#E9EFF8"/><Setter Property="Padding" Value="8"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
<Style TargetType="ProgressBar"><Setter Property="Foreground" Value="#5EE0BA"/><Setter Property="Background" Value="#26334A"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Height" Value="5"/></Style>
</Application.Resources></Application>
